{
  "name": "metrivo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:python": "cd backend && python3 -m unittest discover -s tests -p 'test_*.py'",
    "seed": "tsx scripts/seed.ts",
    "reclassify": "tsx scripts/reclassify.ts",
    "analytics": "cd backend && .venv/bin/uvicorn app.main:app --port 8000 --reload"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.9",
    "mongoose": "^9.9.2",
    "next": "14.2.35",
    "openai": "^7.4.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
